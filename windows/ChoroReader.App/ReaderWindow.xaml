<Window x:Class="ChoroReader.App.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChoroReader" Height="820" Width="1000">
    <!--
        読書の窓。形式で分けない。
        道具帯・サイドバー・下辺は形式に依らず同じ場所にあり、差し替わるのは舞台だけ。
        殻はすべてネイティブで、WebView の中には入れない。
    -->
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="ButtonBase">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="MinWidth" Value="28" />
        </Style>
        <Style x:Key="PaneTab" TargetType="RadioButton">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 道具帯 -->
        <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4" LastChildFill="True">
            <ToggleButton x:Name="SideToggle" DockPanel.Dock="Left" Style="{StaticResource ToolButton}"
                          Content="☰" ToolTip="サイドバー" Click="OnToggleSide" />
            <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}"
                    Content="‹" ToolTip="戻る" Click="OnGoBack" IsEnabled="False" />
            <Button x:Name="ForwardButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}"
                    Content="›" ToolTip="進む" Click="OnGoForward" IsEnabled="False" />

            <Button x:Name="ShelfButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                    Content="書棚" ToolTip="書棚を開く" Click="OnOpenShelf" />
            <ToggleButton x:Name="StyleButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                          Content="Aa" ToolTip="表示設定" Click="OnToggleStyle" />
            <ToggleButton x:Name="BookmarkButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                          Content="☆" ToolTip="しおり" Click="OnToggleBookmark" />
            <TextBox x:Name="Query" DockPanel.Dock="Right" Width="220" Margin="8,0,2,0" Padding="6,3"
                     KeyDown="OnQueryKey" ToolTip="この書籍を検索（Enter で実行）" />

            <!-- 書名と、いま出しているところ。残った幅をすべて使う。 -->
            <TextBlock x:Name="PlaceLabel" Margin="12,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- 下辺。状態・前後・進み具合。 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusLabel" Text="" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevButton" Style="{StaticResource ToolButton}"
                            Content="‹" ToolTip="前へ" Click="OnGoPrev" />
                    <Button x:Name="NextButton" Style="{StaticResource ToolButton}"
                            Content="›" ToolTip="次へ" Click="OnGoNext" />
                    <TextBlock x:Name="PositionLabel" Text="" Margin="10,0,4,0" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- サイドバー。目次・ページ・検索・しおり。中身は面ごとに差し替わる。 -->
            <DockPanel x:Name="Side" Grid.Column="0" Margin="8,0,4,8">
                <StackPanel x:Name="PaneTabs" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="TocTab" Style="{StaticResource PaneTab}" GroupName="pane"
                                 Content="目次" IsChecked="True" Checked="OnPaneChanged" />
                    <RadioButton x:Name="PagesTab" Style="{StaticResource PaneTab}" GroupName="pane"
                                 Content="ページ" Checked="OnPaneChanged" />
                    <RadioButton x:Name="FoundTab" Style="{StaticResource PaneTab}" GroupName="pane"
                                 Content="検索" Checked="OnPaneChanged" />
                    <RadioButton x:Name="MarksTab" Style="{StaticResource PaneTab}" GroupName="pane"
                                 Content="しおり" Checked="OnPaneChanged" />
                </StackPanel>

                <Grid>
                    <ListBox x:Name="Rows" MouseDoubleClick="OnGoRow" />
                    <!-- 一覧が空のときは、空であることの理由を出す。 -->
                    <TextBlock x:Name="PaneNote" Visibility="Collapsed" Margin="12"
                               TextWrapping="Wrap" Foreground="Gray" />
                </Grid>
            </DockPanel>

            <!-- 舞台。形式によって WebView2 かネイティブ描画が入る。 -->
            <ContentControl x:Name="StageHost" Grid.Column="1" Margin="4,0,8,8" />

            <!-- 表示設定。道具帯の Aa から出す。 -->
            <Popup x:Name="StylePanel" Grid.Column="1" PlacementTarget="{Binding ElementName=StyleButton}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        BorderBrush="Gray" BorderThickness="1" Padding="14" Width="300">
                    <StackPanel>
                        <TextBlock Text="テーマ" Margin="0,0,0,4" />
                        <ComboBox x:Name="ThemePicker" SelectionChanged="OnStyleChanged">
                            <ComboBoxItem Content="明るい" IsSelected="True" />
                            <ComboBoxItem Content="セピア" />
                            <ComboBoxItem Content="暗い" />
                        </ComboBox>

                        <StackPanel x:Name="ReflowableOnly" Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock Text="文字サイズ" />
                                <TextBlock x:Name="SizeValue" HorizontalAlignment="Right" Foreground="Gray" />
                            </DockPanel>
                            <Slider x:Name="SizeSlider" Minimum="70" Maximum="220" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="OnStyleSlid" />

                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="行間" />
                                <TextBlock x:Name="LineValue" HorizontalAlignment="Right" Foreground="Gray" />
                            </DockPanel>
                            <Slider x:Name="LineSlider" Minimum="1.2" Maximum="2.6" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" ValueChanged="OnStyleSlid" />

                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="本文幅" />
                                <TextBlock x:Name="WidthValue" HorizontalAlignment="Right" Foreground="Gray" />
                            </DockPanel>
                            <Slider x:Name="WidthSlider" Minimum="28" Maximum="100" TickFrequency="2"
                                    IsSnapToTickEnabled="True" ValueChanged="OnStyleSlid" />

                            <CheckBox x:Name="CodeWrapBox" Content="コードを折り返す" Margin="0,10,0,0"
                                      Click="OnStyleChanged" />
                            <CheckBox x:Name="PublisherBox" Content="出版社のスタイルを優先" Margin="0,6,0,0"
                                      Click="OnStyleChanged" />
                        </StackPanel>

                        <!-- 紙面には効かない設定を並べても、触れるだけで何も起きない。 -->
                        <TextBlock x:Name="StyleNote" Visibility="Collapsed" Margin="0,10,0,0"
                                   TextWrapping="Wrap" Foreground="Gray"
                                   Text="この書籍はページの見た目が決まっているため、文字の組み直しはできません。" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</Window>
