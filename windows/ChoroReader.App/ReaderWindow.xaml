<Window x:Class="ChoroReader.App.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChoroReader" Height="820" Width="1000">
    <!--
        読書の窓。形式で分けない。
        道具帯・サイドバー・下辺は形式に依らず同じ場所にあり、差し替わるのは舞台だけ。
        殻はすべてネイティブで、WebView の中には入れない。
    -->
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="ButtonBase">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="MinWidth" Value="28" />
        </Style>

        <!--
            字形は**専用の書体**で描く。
            ☰ や ‹ › を本文と同じ書体で置くと、大きさも太さも基線も揃わない。
            Windows 11 は Segoe Fluent Icons、10 は Segoe MDL2 Assets を持つ。
            符号位置は共通なので、両方を並べて書けばどちらでも出る。
            **私用領域の符号なので、書体が無いと何も出ない。** 字形の意味は ToolTip に持たせる。
        -->
        <Style x:Key="ToolIcon" TargetType="ButtonBase" BasedOn="{StaticResource ToolButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- しおりは付いていれば塗り潰す。押した状態が字形でも分かる。 -->
        <Style x:Key="BookmarkIcon" TargetType="ToggleButton" BasedOn="{StaticResource ToolIcon}">
            <Setter Property="Content" Value="&#xE734;" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="&#xE735;" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--
            選び分けをタブに見せる。
            **RadioButton をそのまま置くと丸が並ぶ。** 見た目を差し替えないと、
            「どれか 1 つ」という意味は伝わっても、タブには見えない。
            ToggleButton を土台にすると、押し込んだ釦の見た目になる。
        -->
        <Style x:Key="PaneTab" TargetType="RadioButton"
               BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="MinWidth" Value="56" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 道具帯 -->
        <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4" LastChildFill="True">
            <ToggleButton x:Name="SideToggle" DockPanel.Dock="Left" Style="{StaticResource ToolIcon}"
                          Content="&#xE700;" ToolTip="サイドバー" Click="OnToggleSide" />
            <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource ToolIcon}"
                    Content="&#xE72B;" ToolTip="戻る" Click="OnGoBack" IsEnabled="False" />
            <Button x:Name="ForwardButton" DockPanel.Dock="Left" Style="{StaticResource ToolIcon}"
                    Content="&#xE72A;" ToolTip="進む" Click="OnGoForward" IsEnabled="False" />

            <Button x:Name="ShelfButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                    Content="書棚" ToolTip="書棚を開く" Click="OnOpenShelf" />
            <ToggleButton x:Name="StyleButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                          Content="Aa" ToolTip="表示設定" Click="OnToggleStyle" />
            <ToggleButton x:Name="BookmarkButton" DockPanel.Dock="Right"
                          Style="{StaticResource BookmarkIcon}"
                          ToolTip="しおり" Click="OnToggleBookmark" />
            <TextBox x:Name="Query" DockPanel.Dock="Right" Width="220" Margin="8,0,2,0" Padding="6,3"
                     KeyDown="OnQueryKey" ToolTip="この書籍を検索（Enter で実行）" />

            <!-- 書名と、いま出しているところ。残った幅をすべて使う。 -->
            <TextBlock x:Name="PlaceLabel" Margin="12,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- 下辺。状態・前後・進み具合。 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusLabel" Text="" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevButton" Style="{StaticResource ToolIcon}"
                            Content="&#xE76B;" ToolTip="前へ" Click="OnGoPrev" />
                    <Button x:Name="NextButton" Style="{StaticResource ToolIcon}"
                            Content="&#xE76C;" ToolTip="次へ" Click="OnGoNext" />
                    <TextBlock x:Name="PositionLabel" Text="" Margin="10,0,4,0" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="0" />
                <!-- 仕切り。サイドバーを閉じているときは幅を持たない。 -->
                <ColumnDefinition x:Name="SplitColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- サイドバー。目次・ページ・検索・しおり。中身は面ごとに差し替わる。 -->
            <DockPanel x:Name="Side" Grid.Column="0" Margin="8,0,4,8">
                <StackPanel x:Name="PaneTabs" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="TocTab" Style="{StaticResource PaneTab}" GroupName="pane"
                                 Content="目次" IsChecked="True" Checked="OnPaneChanged" />
                    <RadioButton x:Name="PagesTab" Style="{StaticResource PaneTab}" GroupName="pane"
                                 Content="ページ" Checked="OnPaneChanged" />
                    <RadioButton x:Name="FoundTab" Style="{StaticResource PaneTab}" GroupName="pane"
                                 Content="検索" Checked="OnPaneChanged" />
                    <RadioButton x:Name="MarksTab" Style="{StaticResource PaneTab}" GroupName="pane"
                                 Content="しおり" Checked="OnPaneChanged" />
                </StackPanel>

                <Grid>
                    <!--
                        **1 行の文字列で出さない。** 検索結果は「どの章か」と「本文」で
                        重さが違うし、目次は階層を持つ。同じ一覧を 4 つの面で使い回すので、
                        体裁は 1 つにして、出るものの有無で見え方を変える。
                    -->
                    <ListBox x:Name="Rows" MouseDoubleClick="OnGoRow"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 字下げは余白でやる。空白文字だと字形の幅で揃わない。 -->
                                <StackPanel Margin="{Binding Indent}">
                                    <TextBlock Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="Detail" Text="{Binding Detail}"
                                               TextWrapping="Wrap" MaxHeight="36"
                                               TextTrimming="CharacterEllipsis"
                                               Opacity="0.7" Margin="0,1,0,0" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                        <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 一覧が空のときは、空であることの理由を出す。 -->
                    <TextBlock x:Name="PaneNote" Visibility="Collapsed" Margin="12"
                               TextWrapping="Wrap" Foreground="Gray" />
                </Grid>
            </DockPanel>

            <!-- 長い目次では幅が足りない。掴んで動かせるようにする。 -->
            <GridSplitter x:Name="SideSplitter" Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />

            <!-- 舞台。形式によって WebView2 かネイティブ描画が入る。 -->
            <ContentControl x:Name="StageHost" Grid.Column="2" Margin="4,0,8,8" />

            <!-- 表示設定。道具帯の Aa から出す。 -->
            <Popup x:Name="StylePanel" Grid.Column="2" PlacementTarget="{Binding ElementName=StyleButton}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <!--
                    **地の色と文字の色は対で置く。** 覆いは窓の外に出るので、
                    地だけを指定すると、明暗が切り替わったときに白地に白文字になりうる。
                -->
                <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                        BorderBrush="Gray" BorderThickness="1" Padding="14" Width="300">
                    <StackPanel>
                        <TextBlock Text="テーマ" Margin="0,0,0,4" />
                        <ComboBox x:Name="ThemePicker" SelectionChanged="OnStyleChanged">
                            <ComboBoxItem Content="明るい" IsSelected="True" />
                            <ComboBoxItem Content="セピア" />
                            <ComboBoxItem Content="暗い" />
                        </ComboBox>

                        <StackPanel x:Name="ReflowableOnly" Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock Text="文字サイズ" />
                                <TextBlock x:Name="SizeValue" HorizontalAlignment="Right" Foreground="Gray" />
                            </DockPanel>
                            <Slider x:Name="SizeSlider" Minimum="70" Maximum="220" TickFrequency="5"
                                    IsSnapToTickEnabled="True" />

                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="行間" />
                                <TextBlock x:Name="LineValue" HorizontalAlignment="Right" Foreground="Gray" />
                            </DockPanel>
                            <Slider x:Name="LineSlider" Minimum="1.2" Maximum="2.6" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" />

                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="本文幅" />
                                <TextBlock x:Name="WidthValue" HorizontalAlignment="Right" Foreground="Gray" />
                            </DockPanel>
                            <Slider x:Name="WidthSlider" Minimum="28" Maximum="100" TickFrequency="2"
                                    IsSnapToTickEnabled="True" />

                            <CheckBox x:Name="CodeWrapBox" Content="コードを折り返す" Margin="0,10,0,0"
                                      Click="OnStyleChanged" />
                            <CheckBox x:Name="PublisherBox" Content="出版社のスタイルを優先" Margin="0,6,0,0"
                                      Click="OnStyleChanged" />
                        </StackPanel>

                        <!-- 紙面には効かない設定を並べても、触れるだけで何も起きない。 -->
                        <TextBlock x:Name="StyleNote" Visibility="Collapsed" Margin="0,10,0,0"
                                   TextWrapping="Wrap" Foreground="Gray"
                                   Text="この書籍はページの見た目が決まっているため、文字の組み直しはできません。" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</Window>
