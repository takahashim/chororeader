<Window x:Class="ChoroReader.App.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="書棚 — ChoroReader" Height="720" Width="960" AllowDrop="True">
    <!-- 書棚はすべてネイティブ。WebView は使わない。 -->
    <Window.Resources>
        <!-- 表紙で並べるときの 1 冊。表紙・題名・読み進み。 -->
        <DataTemplate x:Key="CoverCard">
            <StackPanel Width="150" Margin="8">
                <Border Height="200" Background="#20808080" BorderBrush="#40808080" BorderThickness="1">
                    <Grid>
                        <!-- 表紙が取れない書籍もある。そのときは題名だけが出る。 -->
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="10"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   TextAlignment="Center" Foreground="Gray" />
                        <Image Source="{Binding Cover}" Stretch="Uniform" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxHeight="36"
                           Margin="0,6,0,2" TextTrimming="CharacterEllipsis" />
                <ProgressBar Height="4" Maximum="1" Value="{Binding Progression, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,8,0">
                <RadioButton x:Name="CoverMode" GroupName="mode" Content="表紙" Padding="8,3"
                             IsChecked="True" Checked="OnModeChanged" ToolTip="表紙で並べる" />
                <RadioButton x:Name="TableMode" GroupName="mode" Content="一覧" Padding="8,3"
                             Margin="2,0,0,0" Checked="OnModeChanged" ToolTip="表で並べる" />
            </StackPanel>

            <Button x:Name="AddButton" DockPanel.Dock="Right" Content="本を加える…"
                    Padding="10,4" Margin="8,0,0,0" Click="OnAdd" />
            <Button x:Name="SampleButton" DockPanel.Dock="Right" Content="見本を並べる"
                    Padding="10,4" Margin="8,0,0,0" Click="OnAddSamples"
                    ToolTip="同梱の見本（リフロー EPUB・固定レイアウト EPUB・PDF）" />
            <TextBox x:Name="Query" Padding="6,4"
                     KeyDown="OnQueryKey" ToolTip="蔵書を横断して引く（Enter で実行）" />
        </DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusLabel" Text="" />
            </StatusBarItem>
        </StatusBar>

        <!--
            面は 3 つあり、同時には 1 つしか出さない。
            引いていないときは蔵書（表紙か一覧）、引いたときは結果。
        -->
        <Grid Margin="8,0,8,8">
            <ListBox x:Name="Covers" ItemTemplate="{StaticResource CoverCard}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnOpenBook">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <DataGrid x:Name="Table" Visibility="Collapsed" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      MouseDoubleClick="OnOpenBook">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="題名" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="形式" Binding="{Binding Kind}" Width="120" />
                    <DataGridTextColumn Header="読み進み" Binding="{Binding Percent}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <ListBox x:Name="Hits" Visibility="Collapsed" MouseDoubleClick="OnOpenHit" />

            <!-- 1 冊も無いときは、できることを出す。空の書棚だけ見せても分からない。 -->
            <StackPanel x:Name="Empty" Visibility="Collapsed" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="まだ書籍がありません。" Margin="0,0,0,6" HorizontalAlignment="Center" />
                <TextBlock Text="EPUB か PDF をこの窓に落とすか、「本を加える…」から選んでください。"
                           Foreground="Gray" Margin="0,0,0,6" HorizontalAlignment="Center" />
                <TextBlock Text="手元に書籍が無いときは、同梱の見本で試せます。"
                           Foreground="Gray" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
