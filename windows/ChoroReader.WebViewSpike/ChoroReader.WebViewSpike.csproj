<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WebView2 は Windows 専用。このプロジェクトだけは Windows 向け TFM にする。
         Core と Probe は net10.0 のままにしておくこと（macOS で突き合わせを回すため）。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>chorowebviewspike</AssemblyName>
    <!-- 結果を標準出力へ書くため、コンソールを持たせる。 -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <!-- macOS でもコンパイルだけは通せるようにする。実行は Windows でしかできないが、
         CI へ出す前に型と API の誤りを開発機で潰せる。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

</Project>
